<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PocketTerm.Desktop.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The core tests' helpers: tool/vectors/vectors.json, fake servers, the real Dart server. -->
    <Compile Include="..\PocketTerm.Core.Tests\Vectors.cs" Link="Shared\Vectors.cs" />
    <Compile Include="..\PocketTerm.Core.Tests\TestServers.cs" Link="Shared\TestServers.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PocketTerm.Core\PocketTerm.Core.csproj" />
    <ProjectReference Include="..\PocketTerm.Desktop.Core\PocketTerm.Desktop.Core.csproj" />
  </ItemGroup>
</Project>
