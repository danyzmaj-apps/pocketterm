<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The user's own server and FCM. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Terminal pushes and followed sessions; asked for at runtime on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scanning the setup code the computer shows (CameraX + ML Kit); asked for when the scanner opens. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- A device without a camera can still try the demo. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Voice prompts, recognized on the phone; asked for the first time the composer's microphone is used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Haptic feedback on taps that change something. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- No backup and no device-to-device transfer (dataExtractionRules, Android 12+, where
         allowBackup alone doesn't stop the transfer): the computers' channel keys and the
         session stay on this phone. Cleartext is allowed because the server is the person's own and
         may be plain http on their network or tailnet (the Flutter app's HTTP client allowed it too);
         everything about the sessions goes end-to-end sealed either way. -->
    <application
        android:name=".PocketTermApp"
        android:label="PocketTerm"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PocketTerm">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.PocketTerm.Starting"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <!-- The launcher entry in debug builds; release builds take it out (src/release/AndroidManifest.xml)
                 for the icon aliases below. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Setup links with the computer's sign-in code (pocketterm://setup?…&code=…), and
                 followed sessions' links (pocketterm://session?key=…). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pocketterm" />
            </intent-filter>
        </activity>

        <!-- The launcher icons (core AppIcon.kt; drawn by apps/pocketterm-desktop/tool/make_icon.swift):
             IconDefault, the app's own (Catppuccin Mocha's), and one per other theme. Release builds enable
             IconDefault; AppIcons.kt enables the chosen theme's and disables the rest. The names are the Flutter
             app's, so a phone that upgrades keeps the icon it had. -->
        <activity-alias
            android:name=".IconDefault"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Retired: 0.1.2's Mocha icon, now IconDefault's. A phone that had picked it starts the app through this
             one until AppIcons.kt moves it to IconDefault (it never enables it again); without it, that phone's
             launcher would have no entry after the update. -->
        <activity-alias
            android:name=".IconMocha"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconDawn"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_dawn"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconTokyoNight"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_tokyo_night"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Retired: 0.1.7's Gruvbox icon; Gruvbox is gone and its people moved to Catppuccin, whose icon is
             IconDefault's. Kept, with that icon, for the same reason as IconMocha: a phone that had picked it starts
             the app through this one until AppIcons.kt moves it to IconDefault. -->
        <activity-alias
            android:name=".IconGruvbox"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Followed coding sessions (SessionActivities.kt). -->
        <receiver android:name=".ActivityDismissReceiver" android:exported="false" />
        <receiver android:name=".ActivityStaleReceiver" android:exported="false" />

        <!-- Pushes from the user's server through the relay (PushService.kt). -->
        <service android:name=".PushService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
    <queries>
        <!-- Links in answers and the GitHub/download links open in the browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Voice prompts: Android 11+ shows the speech recognizer only to apps that ask for it here. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
