<!-- The app's few styles, loaded at start (Styles.Load) on top of WinUI's own. They exist for the theme
     brushes: a style's {ThemeResource} follows Windows switching light and dark, a brush set in code doesn't. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Secondary text: descriptions under titles, notes. -->
  <Style x:Key="PtDim" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="PtBody" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="PtStrong" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="PtSubtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="PtTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- A section's name above its cards, as in Windows Settings. -->
  <Style x:Key="PtSection" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="1,16,0,4" />
  </Style>
  <Style x:Key="PtOkText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
  </Style>
  <Style x:Key="PtWarnText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
  </Style>
  <Style x:Key="PtErrorText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
  </Style>

  <!-- Icons in the state colors (FontIcon). -->
  <Style x:Key="PtOkIcon" TargetType="FontIcon">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
  </Style>
  <Style x:Key="PtWarnIcon" TargetType="FontIcon">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
  </Style>
  <Style x:Key="PtErrorIcon" TargetType="FontIcon">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
  </Style>
  <Style x:Key="PtDimIcon" TargetType="FontIcon">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="PtAccentIcon" TargetType="FontIcon">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
  </Style>

  <!-- A settings card (Windows 11 Settings' rows). -->
  <Style x:Key="PtCard" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="16,14,16,14" />
  </Style>
  <!-- A card's second part (its body below the header row), as in SettingsExpander. -->
  <Style x:Key="PtCardBody" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,12,16,14" />
  </Style>
  <!-- A small boxed note (Flutter's _notice). -->
  <Style x:Key="PtNote" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="12,10,12,10" />
  </Style>
  <Style x:Key="PtDivider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
  </Style>
</ResourceDictionary>
