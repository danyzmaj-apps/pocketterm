<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Release builds: the launcher shows the icon alias AppIcons.kt picks (IconDefault until a theme's is
         chosen) instead of MainActivity itself, which debug and profile builds keep as the launcher entry for
         `flutter run` (it only starts an <activity>, never an alias). -->
    <application>
        <activity android:name=".MainActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".IconDefault"
            android:enabled="true"
            tools:replace="android:enabled" />
    </application>
</manifest>
