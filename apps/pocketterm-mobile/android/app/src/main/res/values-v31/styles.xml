<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The splash for a chosen icon: MainActivity hands it to the system (Android 13+,
         SplashScreen.setSplashScreenTheme), which keeps it for the next cold starts: the icon on its theme's
         background, light or dark as the system is (values/colors.xml, values-night/colors.xml). -->
    <style name="LaunchTheme.Default" parent="Theme.PocketTerm">
        <item name="android:windowSplashScreenBackground">@color/pocketterm_win</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
    <style name="LaunchTheme.Dawn" parent="Theme.PocketTerm">
        <item name="android:windowSplashScreenBackground">@color/pocketterm_dawn</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_dawn_foreground</item>
    </style>
    <style name="LaunchTheme.TokyoNight" parent="Theme.PocketTerm">
        <item name="android:windowSplashScreenBackground">@color/pocketterm_tokyo_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_tokyo_night_foreground</item>
    </style>
</resources>
